{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fleet-chatgpt-connections",
  "main": "src/worker-entry.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "mcp.significanthobbies.com", "custom_domain": true },
    { "pattern": "mcp.highsignal.app", "custom_domain": true },
    { "pattern": "mcp.codevetter.com", "custom_domain": true }
  ],
  "secrets": {
    "required": [
      "SETLINE_MCP_TOKEN",
      "AUTH0_ISSUER",
      "AUTH0_OWNER_USER_ID"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
